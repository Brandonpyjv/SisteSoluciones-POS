DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=sistesoluciones
SESSION_SECRET=cambia-esta-clave-secreta

# Puerto propio: FactuGest corre en el 8000 y los dos tienen que convivir.
PORT=8001

# Conexion con FactuGest, el proveedor tecnologico que emite las facturas.
# La llave la entrega FactuGest al dar de alta el cliente API.
FACTUGEST_URL=http://127.0.0.1:8000
FACTUGEST_API_KEY=

# Cierre de sesion por inactividad. Trabajar renueva el reloj en cada peticion;
# lo que cierra la sesion es dejar de trabajar.
SESION_MINUTOS=30
SESION_AVISO_MINUTOS=2

# En produccion, con HTTPS, la cookie de sesion no debe viajar en claro.
COOKIES_SEGURAS=no
